{
  "family": "clockchain-mechanics-proof-responder",
  "requiresCompatibilities": ["FARGATE"],
  "networkMode": "awsvpc",
  "cpu": "512",
  "memory": "1024",
  "runtimePlatform": {
    "operatingSystemFamily": "LINUX",
    "cpuArchitecture": "X86_64"
  },
  "taskRoleArn": "arn:aws:iam::123456789012:role/clockchain-mechanics-proof-responder-task",
  "executionRoleArn": "arn:aws:iam::123456789012:role/clockchain-mechanics-proof-responder-execution",
  "containerDefinitions": [
    {
      "name": "responder",
      "image": "docker.io/library/node:24.11.1-bookworm-slim@sha256:44b49d6e2d23f6754fb084ef9d34ff14590343ad1ee168f8acf8f7bc9fccde2f",
      "essential": true,
      "user": "10002",
      "readonlyRootFilesystem": true,
      "privileged": false,
      "portMappings": [
        { "containerPort": 8443, "protocol": "tcp" }
      ],
      "environment": [
        { "name": "CLOCKCHAIN_ROLE", "value": "responder" },
        { "name": "CLOCKCHAIN_MCP_URL", "value": "https://mcp.clockchain.network/handshake/mcp" },
        { "name": "CLOCKCHAIN_A2A_PORT", "value": "8443" },
        { "name": "NODE_ENV", "value": "production" }
      ],
      "secrets": [
        {
          "name": "CLOCKCHAIN_PROVIDER_REF",
          "valueFrom": "arn:aws:secretsmanager:us-west-2:123456789012:secret:clockchain/mechanics-proof/responder/provider"
        },
        {
          "name": "CLOCKCHAIN_MCP_CREDENTIAL_REF",
          "valueFrom": "arn:aws:secretsmanager:us-west-2:123456789012:secret:clockchain/mechanics-proof/responder/mcp"
        },
        {
          "name": "CLOCKCHAIN_SIGNER_REF",
          "valueFrom": "arn:aws:ssm:us-west-2:123456789012:parameter/clockchain/mechanics-proof/responder/signer"
        },
        {
          "name": "CLOCKCHAIN_STATE_REF",
          "valueFrom": "arn:aws:ssm:us-west-2:123456789012:parameter/clockchain/mechanics-proof/responder/state"
        }
      ],
      "mountPoints": [
        {
          "sourceVolume": "responder-workspace",
          "containerPath": "/workspace",
          "readOnly": false
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/clockchain/mechanics-proof/responder",
          "awslogs-region": "us-west-2",
          "awslogs-stream-prefix": "responder",
          "mode": "blocking"
        }
      }
    }
  ],
  "volumes": [
    { "name": "responder-workspace" }
  ]
}
