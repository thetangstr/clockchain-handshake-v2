{
  "name": "clockchain-handshake",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Bilateral payment-authorization handshake demo: two agents, three Clockchain anchors, one fresh verifier.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "preflight": "CLOCKCHAIN_FUNDING_PASSWORD_FILE=\"${CLOCKCHAIN_FUNDING_PASSWORD_FILE:-$PWD/keys/funding.password}\" node scripts/preflight.mjs",
    "demo": "CLOCKCHAIN_FUNDING_PASSWORD_FILE=\"${CLOCKCHAIN_FUNDING_PASSWORD_FILE:-$PWD/keys/funding.password}\" HANDSHAKE_RELAY=\"${HANDSHAKE_RELAY:-http://44.249.47.220:8080}\" node bin/operator.mjs",
    "host": "CLOCKCHAIN_FUNDING_PASSWORD_FILE=\"${CLOCKCHAIN_FUNDING_PASSWORD_FILE:-$PWD/keys/funding.password}\" HANDSHAKE_RELAY=\"${HANDSHAKE_RELAY:-http://44.249.47.220:8080}\" node bin/clockchain-host.mjs",
    "demo:local": "CLOCKCHAIN_FUNDING_PASSWORD_FILE=\"${CLOCKCHAIN_FUNDING_PASSWORD_FILE:-$PWD/keys/funding.password}\" node scripts/run-local-demo.mjs",
    "negative": "node scripts/negative-checks.mjs",
    "test": "node --test --test-concurrency=4 test/*.test.mjs",
    "verify": "npm run test && bash scripts/check-invariants.sh",
    "release:pin": "node scripts/release-pin.mjs"
  },
  "dependencies": {
    "viem": "2.55.8"
  }
}
