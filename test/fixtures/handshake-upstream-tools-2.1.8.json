      "title": "Create stakeholder handshake",
      "description": "Create one handshake, the Initiator role access, and one single-use Responder invitation.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "reference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "validForSeconds": {
            "type": "string",
            "pattern": "^(?:[1-9]|[1-8][0-9]|90)$"
          },
          "identityPolicy": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "erc8004": {
                    "type": "string",
                    "const": "required_fresh"
                  },
                  "chainId": {
                    "type": "string",
                    "const": "eip155:11155111"
                  },
                  "registryAddress": {
                    "type": "string",
                    "const": "0x8004a818bfb912233c491871b3d84c89a494bd9e"
                  }
                },
                "required": [
                  "erc8004",
                  "chainId",
                  "registryAddress"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "erc8004": {
                    "type": "string",
                    "const": "required_existing_or_fresh"
                  },
                  "chainId": {
                    "type": "string",
                    "const": "eip155:11155111"
                  },
                  "registryAddress": {
                    "type": "string",
                    "const": "0x8004a818bfb912233c491871b3d84c89a494bd9e"
                  }
                },
                "required": [
                  "erc8004",
                  "chainId",
                  "registryAddress"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "erc8004": {
                    "type": "string",
                    "const": "not_required"
                  },
                  "chainId": {
                    "type": "null"
                  },
                  "registryAddress": {
                    "type": "null"
                  }
                },
                "required": [
                  "erc8004",
                  "chainId",
                  "registryAddress"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "reference",
          "statement",
          "validForSeconds",
          "identityPolicy"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
